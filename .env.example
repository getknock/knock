# Copy to .env and fill in. .env is gitignored; never commit real values.

# knockd's gas key on World Chain (pays for bind()).
RELAYER_WALLET_ADDRESS=
RELAYER_WALLET_PRIV_KEY=

# RPC endpoints.
WORLD_RPC=
ETH_RPC=

# World ID relying party (public identifiers).
WORLD_APP_ID=
WORLD_RP_ID=

# Path to the World RP signing key file (gitignored).
WORLD_RP_KEY_FILE=knock-worldchain-key.json
